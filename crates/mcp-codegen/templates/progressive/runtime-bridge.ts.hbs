/**
 * MCP Runtime Bridge - Connection management and tool execution
 *
 * This module provides the runtime bridge between generated TypeScript tools
 * and MCP servers. It handles:
 * - Server connection management with caching
 * - JSON-RPC 2.0 protocol communication
 * - Error handling and reporting
 * - Process lifecycle management
 *
 * @module mcp-bridge
 */

import { spawn, ChildProcess } from 'child_process';
import { readFile } from 'fs/promises';
import { homedir } from 'os';
import { join } from 'path';

/**
 * Configuration for an MCP server
 */
interface ServerConfig {
  /** Transport type; "stdio" if omitted. Only "stdio" is executable by this bridge — see
   * {@link validateServerConfig}. */
  transport?: string;
  /** Command to execute (e.g., "docker", "node", "npx"). Stdio transport only. */
  command: string;
  /** Arguments to pass to the command. Stdio transport only. */
  args: string[];
  /** Environment variables. Stdio transport only. */
  env?: Record<string, string>;
  /** Working directory. Stdio transport only. */
  cwd?: string;
  /** Server endpoint URL. Http/Sse transport only. */
  url?: string;
  /** HTTP headers. Http/Sse transport only. */
  headers?: Record<string, string>;
}

/**
 * JSON-RPC 2.0 request for tool invocation
 */
interface MCPToolCallRequest {
  jsonrpc: '2.0';
  id: number;
  method: 'tools/call';
  params: {
    name: string;
    arguments: Record<string, unknown>;
  };
}

/**
 * JSON-RPC 2.0 response from tool invocation
 *
 * `content` and `structuredContent` mirror `rmcp::model::CallToolResult`: `content` defaults
 * to `[]` server-side, so it is legitimately absent or empty — never assume a first element.
 * `callMCPTool` treats an empty `content` paired with `structuredContent` as a valid
 * "no textual output" result; an empty `content` with no `structuredContent` either is
 * surfaced as a thrown error, since the bridge cannot distinguish a genuinely void tool from a
 * misbehaving server at this layer.
 */
interface MCPToolCallResponse {
  jsonrpc: '2.0';
  id: number;
  result?: {
    content?: Array<{
      type: string;
      text?: string;
      [key: string]: unknown;
    }>;
    structuredContent?: unknown;
    isError?: boolean;
  };
  error?: {
    code: number;
    message: string;
    data?: unknown;
  };
}

/**
 * Initialize request sent to MCP server
 */
interface MCPInitializeRequest {
  jsonrpc: '2.0';
  id: number;
  method: 'initialize';
  params: {
    protocolVersion: string;
    capabilities: {
      tools?: Record<string, unknown>;
    };
    clientInfo: {
      name: string;
      version: string;
    };
  };
}

/**
 * A single pending JSON-RPC request awaiting its response.
 */
interface PendingRequest {
  resolve: (message: MCPToolCallResponse) => void;
  reject: (error: Error) => void;
}

/**
 * An active connection to an MCP server: the child process plus the
 * in-flight requests awaiting a response, keyed by JSON-RPC request id.
 */
interface ServerConnection {
  process: ChildProcess;
  pending: Map<number, PendingRequest>;
}

/**
 * Cache of active (or in-flight) server connections.
 *
 * Key: serverId, Value: promise resolving to the connection once the child process has
 * spawned and completed the JSON-RPC `initialize` handshake. Caching the in-flight promise
 * (not just the eventually-resolved connection) means concurrent callers on a cold serverId
 * await the same connection setup instead of each spawning a competing child process.
 */
const serverConnections = new Map<string, Promise<ServerConnection>>();

/**
 * Child processes spawned for active connections, tracked separately from
 * {@link serverConnections} so the synchronous `process.on('exit', ...)` handler can kill
 * them without needing to await a possibly-still-pending connection promise.
 */
const activeProcesses = new Set<ChildProcess>();

/**
 * Request ID counter for JSON-RPC
 */
let requestIdCounter = 1;

/**
 * Debug mode flag (set via MCPBRIDGE_DEBUG environment variable)
 */
const DEBUG = process.env.MCPBRIDGE_DEBUG === '1';

/**
 * Log debug message if debug mode is enabled
 */
function debug(...args: unknown[]): void {
  if (DEBUG) {
    console.error('[mcp-bridge]', ...args);
  }
}

/**
 * Shell metacharacters that indicate potential command injection.
 *
 * Rendered directly from `mcp-execution-core`'s `forbidden_chars()` (`command.rs`) at code
 * generation time — not hand-copied — so this list can never silently drift from the Rust
 * source of truth.
 */
const FORBIDDEN_CHARS = [{{#each forbidden_chars}}'{{{this}}}'{{#unless @last}}, {{/unless}}{{/each}}];

/**
 * Forbidden environment variable names that pose security risks.
 *
 * Rendered directly from `mcp-execution-core`'s `forbidden_env_names()` (`command.rs`) at
 * code generation time, for the same drift-elimination reason as {@link FORBIDDEN_CHARS}.
 * `{{{forbidden_env_prefix}}}*` is additionally rejected as a prefix match, not just these
 * exact names — see {@link validateEnvName}.
 */
const FORBIDDEN_ENV_NAMES = [{{#each forbidden_env_names}}'{{{this}}}'{{#unless @last}}, {{/unless}}{{/each}}];

/**
 * Environment-variable-name prefix rejected regardless of exact match, rendered directly
 * from `mcp-execution-core`'s `forbidden_env_prefix()` (`command.rs`).
 */
const FORBIDDEN_ENV_PREFIX = '{{{forbidden_env_prefix}}}';

/**
 * POSIX/Windows environment-variable-name identifier charset, rendered directly from
 * `mcp-execution-core`'s `env_name_charset_pattern()` (`command.rs`). Used by
 * {@link validateEnvName} to close the #467 gap: this bridge previously relied entirely on
 * `String.prototype.toUpperCase()`'s incidental Unicode case folding, with no explicit charset
 * check of its own.
 */
const ENV_NAME_CHARSET_REGEX = new RegExp('{{{env_name_charset_pattern}}}');

/**
 * Human-readable description of {@link ENV_NAME_CHARSET_REGEX}, rendered directly from
 * `mcp-execution-core`'s `env_name_charset_desc()` (`command.rs`) so {@link validateEnvName}'s
 * rejection message doesn't hand-copy the same literal a second time.
 */
const ENV_NAME_CHARSET_DESC = '{{{env_name_charset_desc}}}';

/**
 * Denial-of-service (CWE-400) size/count ceilings, rendered directly from
 * `mcp-execution-core`'s constants of the same name (`command.rs`), enforced by
 * {@link validateStdioSizeBounds} and {@link validateNetworkSizeBounds} before any
 * command-injection-specific check runs — mirroring the ordering in
 * `mcp_execution_core::validate_server_config`.
 */
const MAX_ARG_COUNT = {{max_arg_count}};
const MAX_ARG_LEN = {{max_arg_len}};
const MAX_ENV_COUNT = {{max_env_count}};
const MAX_ENV_VALUE_LEN = {{max_env_value_len}};
const MAX_URL_LEN = {{max_url_len}};
const MAX_HEADER_COUNT = {{max_header_count}};
const MAX_HEADER_VALUE_LEN = {{max_header_value_len}};

/**
 * Returns the UTF-8 byte length of `value`, matching the semantics of Rust's `str::len()`
 * that `mcp-execution-core`'s size-bound constants (`MAX_ARG_LEN` and siblings) are defined
 * against. `string.length` counts UTF-16 code units instead, which under-counts any non-ASCII
 * character relative to its UTF-8 byte count and would let a config past a bound the Rust
 * source of truth would reject.
 */
function byteLength(value: string): number {
  return Buffer.byteLength(value, 'utf8');
}

/**
 * Returns `Object.entries(value)` when `value` is a non-null, non-array object; `[]` when
 * `value` is `undefined`/`null` (the genuine "field absent" case, preserving the previous
 * `config.env ?? {}`-style semantics); throws for anything else (a string, array, number,
 * boolean).
 *
 * `config.env`/`config.headers` are read from an untyped `JSON.parse` result, so either could
 * actually be any of those shapes at runtime despite `ServerConfig`'s static type — mirroring
 * why `mcp_execution_core`'s `Transport::Stdio.env`/`Transport::Http.headers` being
 * `HashMap<String, String>` makes serde reject a non-map shape at deserialization, before
 * `validate_server_config` ever runs.
 *
 * Critique #471/#467 S5: an earlier revision of this function *returned `[]`* for a
 * string/array `value` instead of throwing, reasoning that this closed the "iterate once per
 * character" cost of `Object.entries`/`Object.keys` on a string. It did — but by turning a
 * rejection into a silent acceptance: with zero entries, `MAX_ENV_COUNT`/`MAX_ENV_VALUE_LEN`
 * and {@link validateEnvName} never ran at all, and `spawn(..., { env: { ...config.env } })`
 * still spreads a string/array *per character/element* — verified under node, a 2000-character
 * string `env` produces 2000 numeric-keyed environment variables, none of them length- or
 * count-checked. Throwing preserves the O(1)-rejection property (still no per-character
 * iteration) without reopening that bypass.
 *
 * @param value - The `config.env`/`config.headers` value to convert to entries
 * @param context - Human-readable description of `value`, used in the thrown message
 * @throws {Error} If `value` is neither `undefined`/`null` nor a non-array object
 */
function recordEntries(value: unknown, context: string): Array<[string, unknown]> {
  if (value === undefined || value === null) {
    return [];
  }
  if (typeof value !== 'object' || Array.isArray(value)) {
    throw new Error(`${context} must be an object mapping names to values`);
  }
  return Object.entries(value);
}

/**
 * Narrows `value` to `string`, throwing `message` if it is not one.
 *
 * `config.env`/`config.headers` values are read from an untyped `JSON.parse` result, so
 * despite `ServerConfig`'s static `Record<string, string>` typing, a value could actually be
 * any JSON type at runtime — an array, object, number, boolean, or `null`. Node's
 * `child_process.spawn` silently *coerces* a non-string `env` value via string conversion
 * (e.g. an array of many long strings becomes their comma-joined concatenation), so letting one
 * reach `spawn()` unrejected would bypass {@link validateStdioSizeBounds}'s length ceiling
 * entirely rather than merely mis-measuring it — the #471/#467 critique's S1 finding. Rejecting
 * outright, rather than measuring `String(value).length`, is the closer mirror of the Rust side:
 * `Transport::Stdio`'s `env`/`Transport::Http`'s `headers` are `HashMap<String, String>`, so a
 * non-string value there is rejected at JSON deserialization, before `validate_server_config`
 * ever runs.
 */
function ensureStringValue(value: unknown, message: string): string {
  if (typeof value !== 'string') {
    throw new Error(message);
  }
  return value;
}

/**
 * Validates a command or argument string for forbidden shell metacharacters.
 *
 * Mirrors `validate_command_string` in `mcp-execution-core`'s `command.rs`. The offending
 * value itself is never included in the thrown message: MCP server commands/arguments
 * routinely carry secrets (e.g. `--token=...`), and this error can surface into tool output
 * visible to the calling model, not just an operator's terminal — mirroring the header-value
 * redaction rule in `mcp-execution-core`'s `command.rs`.
 *
 * @param value - The command or argument string to validate
 * @param context - Human-readable description of the value, used in error messages
 * @throws {Error} If the value is not a string, is empty/whitespace-only, or contains a
 *   forbidden character
 */
function validateCommandString(value: unknown, context: string): void {
  if (typeof value !== 'string') {
    throw new Error(`${context} must be a string`);
  }
  const trimmed = value.trim();
  if (trimmed.length === 0) {
    throw new Error(`${context} cannot be empty`);
  }
  for (const forbidden of FORBIDDEN_CHARS) {
    if (trimmed.includes(forbidden)) {
      throw new Error(
        `${context} contains forbidden shell metacharacter '${forbidden}' (value redacted: ` +
        `MCP server commands/arguments may carry secrets)`
      );
    }
  }
}

/**
 * Validates an environment variable name against the required charset and the forbidden list.
 *
 * Mirrors `validate_env_name` (`mcp-execution-core`'s `command.rs`) in both checks and their
 * order:
 *
 * 1. **Charset** — the name must match {@link ENV_NAME_CHARSET_REGEX}
 *    ({@link ENV_NAME_CHARSET_DESC}), rendered from the Rust source of truth. This closes the
 *    #467 gap: before this check existed here, this function's only defense against a Unicode
 *    case-confusable name (e.g. `ı` U+0131, `ſ` U+017F) was incidental to
 *    `String.prototype.toUpperCase()`'s own Unicode-aware case mapping, not a deliberate
 *    guarantee — a name JavaScript's mapping did not happen to fold onto a forbidden entry
 *    passed through unrejected even though `validate_env_name` (added by #438) already
 *    rejected it outright for being outside the conventional identifier charset.
 * 2. **Forbidden name/prefix** — case-insensitive comparison against `FORBIDDEN_ENV_NAMES`/
 *    `FORBIDDEN_ENV_PREFIX`, since Windows treats environment variable names as
 *    case-insensitive at the OS/`CreateProcess` level, so a case-varied spelling such as
 *    `Path` or `path` must be rejected exactly like the canonical `PATH`. Both are rendered
 *    from the Rust source already upper-cased, so upper-casing `name` before comparing is
 *    sufficient.
 *
 * @param name - The environment variable name to validate
 * @throws {Error} If the name is outside the required charset, or is forbidden (exact match
 *   or `DYLD_*` prefix, case-insensitive)
 */
function validateEnvName(name: string): void {
  if (!ENV_NAME_CHARSET_REGEX.test(name)) {
    throw new Error(
      `environment variable name is not a valid identifier (expected ` +
      `${ENV_NAME_CHARSET_DESC}): ${name}`
    );
  }

  const upperName = name.toUpperCase();
  if (FORBIDDEN_ENV_NAMES.includes(upperName)) {
    throw new Error(`Forbidden environment variable name: ${name}`);
  }
  if (upperName.startsWith(FORBIDDEN_ENV_PREFIX)) {
    throw new Error(`Forbidden environment variable prefix ${FORBIDDEN_ENV_PREFIX}: ${name}`);
  }
}

/**
 * Validates that a URL uses the `http://` or `https://` scheme.
 *
 * Mirrors `validate_url_scheme` in `mcp-execution-core`'s `command.rs`, including its
 * defense-in-depth rationale (rejecting `file://`, `unix://`, etc.) and case-insensitive
 * scheme comparison per RFC 3986.
 *
 * @param url - The URL to validate
 * @param serverId - Server identifier, used in the error message
 * @throws {Error} If the URL's scheme is not `http`/`https`
 */
function validateUrlScheme(url: string, serverId: string): void {
  const schemeMatch = /^([^:]*):\/\//.exec(url);
  const scheme = schemeMatch?.[1]?.toLowerCase();
  if (scheme !== 'http' && scheme !== 'https') {
    throw new Error(`url for server '${serverId}' must use the http:// or https:// scheme`);
  }
}

/**
 * Returns `true` if `c` is a valid RFC 7230 `tchar` (the charset allowed in an HTTP header
 * field name). Mirrors `is_header_name_tchar` in `mcp-execution-core`'s `command.rs`.
 */
function isHeaderNameTchar(c: string): boolean {
  return /^[A-Za-z0-9!#$%&'*+\-.^_`|~]$/.test(c);
}

/**
 * Validates an HTTP header name against the RFC 7230 `token` charset.
 *
 * Mirrors `validate_header_name_string` in `mcp-execution-core`'s `command.rs`: a plain
 * control-character check is not tight enough, since a space, `:`, or `@` is not a control
 * character but is still an invalid header-name character.
 *
 * @param name - The header name to validate
 * @param serverId - Server identifier, used in the error message
 * @throws {Error} If the name is empty or contains a character outside the HTTP token charset
 */
function validateHeaderNameString(name: string, serverId: string): void {
  if (name.length === 0) {
    throw new Error(`header name cannot be empty for server '${serverId}'`);
  }
  for (const c of name) {
    if (!isHeaderNameTchar(c)) {
      throw new Error(
        `header name '${name}' for server '${serverId}' contains characters outside the ` +
        `allowed HTTP token charset`
      );
    }
  }
}

/**
 * Validates an HTTP header value for control characters.
 *
 * Mirrors `validate_header_value_string` in `mcp-execution-core`'s `command.rs`. The header
 * *value* routinely carries secrets (e.g. bearer tokens), so it must never appear in the
 * thrown error — only the header *name* is included.
 *
 * @param name - The header name, used in the error message (the value itself never is)
 * @param value - The header value to validate
 * @param serverId - Server identifier, used in the error message
 * @throws {Error} If the value contains a control character
 */
function validateHeaderValueString(name: string, value: string, serverId: string): void {
  // eslint-disable-next-line no-control-regex -- intentionally matching control characters
  if (/[\x00-\x1f\x7f]/.test(value)) {
    throw new Error(
      `value for header '${name}' for server '${serverId}' contains control characters`
    );
  }
}

/**
 * Bounds `url`'s length and `headers`' count/lengths (denial-of-service protection, CWE-400),
 * mirroring `validate_network_size_bounds` in `mcp-execution-core`'s `command.rs`. Called by
 * {@link validateNetworkConfig} before its injection-specific checks, mirroring the ordering
 * in `mcp_execution_core::validate_server_config`.
 *
 * Assumes `config.url` is already known to be a non-empty string — {@link validateNetworkConfig}
 * checks that first, mirroring `url` being a required (non-optional) field on the Rust
 * `Transport::Http`/`Transport::Sse` variants.
 *
 * A header value that is not a string is rejected outright here (via {@link ensureStringValue})
 * rather than skipped — see that helper's doc comment for why a `typeof value === 'string' &&`
 * guard around the length check alone is not safe for header values.
 *
 * @param config - The server configuration to validate
 * @param serverId - Server identifier, used in error messages
 * @throws {Error} If `url` or any header name/value count/length exceeds its bound, or a
 *   header value is not a string
 */
function validateNetworkSizeBounds(config: ServerConfig, serverId: string): void {
  const url = config.url as string;
  if (byteLength(url) > MAX_URL_LEN) {
    throw new Error(
      `url for server '${serverId}' too long: ${byteLength(url)} bytes exceeds the ` +
      `${MAX_URL_LEN} limit`
    );
  }

  const headerEntries = recordEntries(config.headers, `headers for server '${serverId}'`);
  if (headerEntries.length > MAX_HEADER_COUNT) {
    throw new Error(
      `too many headers for server '${serverId}': ${headerEntries.length} exceeds the ` +
      `${MAX_HEADER_COUNT} limit`
    );
  }
  for (const [name, value] of headerEntries) {
    if (byteLength(name) > MAX_ARG_LEN) {
      throw new Error(
        `header name for server '${serverId}' too long: ${byteLength(name)} bytes exceeds ` +
        `the ${MAX_ARG_LEN} limit`
      );
    }
    const stringValue = ensureStringValue(
      value,
      `value for header '${name}' for server '${serverId}' must be a string`
    );
    if (byteLength(stringValue) > MAX_HEADER_VALUE_LEN) {
      throw new Error(
        `value for header '${name}' for server '${serverId}' too long: ` +
        `${byteLength(stringValue)} bytes exceeds the ${MAX_HEADER_VALUE_LEN} limit`
      );
    }
  }
}

/**
 * Validates the Http/Sse-transport-specific fields of a server configuration.
 *
 * Mirrors `validate_network_config` in `mcp-execution-core`'s `command.rs`: URL presence and
 * scheme, and header name/value safety, including rejecting header names that collide
 * case-insensitively (e.g. `Authorization` and `authorization` both present), since a
 * downstream HTTP client would otherwise silently pick one with no deterministic winner.
 * {@link validateNetworkSizeBounds} runs first, mirroring
 * `mcp_execution_core::validate_server_config`'s size-bounds-before-injection-checks ordering.
 *
 * @param config - The server configuration to validate
 * @param serverId - Server identifier, used in error messages
 * @throws {Error} If `url` is missing, an element count/length exceeds its bound, its scheme
 *   is not http/https, or a header name/value is unsafe
 */
function validateNetworkConfig(config: ServerConfig, serverId: string): void {
  if (typeof config.url !== 'string' || config.url.length === 0) {
    throw new Error(`url is required for server '${serverId}'`);
  }

  validateNetworkSizeBounds(config, serverId);

  validateUrlScheme(config.url, serverId);

  const seenHeaderNames = new Set<string>();
  for (const [name, value] of recordEntries(config.headers, `headers for server '${serverId}'`)) {
    // `validateNetworkSizeBounds` above already rejected any non-string header value, but
    // this loop makes no assumption about running only after it — narrow again rather than
    // asserting the type.
    const stringValue = ensureStringValue(
      value,
      `value for header '${name}' for server '${serverId}' must be a string`
    );
    validateHeaderNameString(name, serverId);
    validateHeaderValueString(name, stringValue, serverId);
    const lowerName = name.toLowerCase();
    if (seenHeaderNames.has(lowerName)) {
      throw new Error(`duplicate header name (case-insensitive) for server '${serverId}': '${name}'`);
    }
    seenHeaderNames.add(lowerName);
  }
}

/**
 * Bounds `command`'s length and `args`'/`env`'s counts/lengths (denial-of-service protection,
 * CWE-400), mirroring `validate_stdio_size_bounds` in `mcp-execution-core`'s `command.rs`.
 * Called by {@link validateServerConfig} before its command-injection-specific checks
 * (`validateCommandString`/`validateEnvName`), mirroring the ordering in
 * `mcp_execution_core::validate_server_config`.
 *
 * Deliberately does not check for shell metacharacters, the env-name charset, or forbidden
 * environment variable names — those remain {@link validateCommandString}/
 * {@link validateEnvName}'s responsibility. A non-string `command` or a non-array `args` is
 * silently skipped here and left for {@link validateCommandString} (called later, on every
 * element) to reject with a precise "must be a string"/"must be an array" error — safe because
 * that later check always runs regardless of what this function does. A non-string *env value*
 * is different: no later check rejects it (env values are only read, in
 * {@link validateEnvName}, by name), so `spawn(..., { env: { ...config.env } })` would silently
 * coerce it via `String()`, bypassing this function's own length ceiling entirely (critique
 * S1) — this function rejects a non-string env value outright instead, via
 * {@link ensureStringValue}.
 *
 * @param config - The server configuration to validate
 * @param serverId - Server identifier, used in error messages
 * @throws {Error} If any element count or length exceeds its bound, or an env value is not a
 *   string
 */
function validateStdioSizeBounds(config: ServerConfig, serverId: string): void {
  if (typeof config.command === 'string' && byteLength(config.command) > MAX_ARG_LEN) {
    throw new Error(
      `command for server '${serverId}' too long: ${byteLength(config.command)} bytes ` +
      `exceeds the ${MAX_ARG_LEN} limit`
    );
  }

  const args = config.args ?? [];
  if (Array.isArray(args)) {
    if (args.length > MAX_ARG_COUNT) {
      throw new Error(
        `too many arguments for server '${serverId}': ${args.length} exceeds the ` +
        `${MAX_ARG_COUNT} limit`
      );
    }
    args.forEach((arg, idx) => {
      if (typeof arg === 'string' && byteLength(arg) > MAX_ARG_LEN) {
        throw new Error(
          `argument ${idx} for server '${serverId}' too long: ${byteLength(arg)} bytes ` +
          `exceeds the ${MAX_ARG_LEN} limit`
        );
      }
    });
  }

  const envEntries = recordEntries(config.env, `env for server '${serverId}'`);
  if (envEntries.length > MAX_ENV_COUNT) {
    throw new Error(
      `too many environment variables for server '${serverId}': ${envEntries.length} ` +
      `exceeds the ${MAX_ENV_COUNT} limit`
    );
  }
  for (const [name, value] of envEntries) {
    if (byteLength(name) > MAX_ARG_LEN) {
      throw new Error(
        `environment variable name too long for server '${serverId}': ${byteLength(name)} ` +
        `bytes exceeds the ${MAX_ARG_LEN} limit`
      );
    }
    const stringValue = ensureStringValue(
      value,
      `environment variable '${name}' value must be a string for server '${serverId}'`
    );
    if (byteLength(stringValue) > MAX_ENV_VALUE_LEN) {
      throw new Error(
        `environment variable '${name}' value too long for server '${serverId}': ` +
        `${byteLength(stringValue)} bytes exceeds the ${MAX_ENV_VALUE_LEN} limit`
      );
    }
  }
}

/**
 * Validates a server configuration for safe execution.
 *
 * `~/.claude/mcp.json` is re-read from disk on every server (re)connection, so a config that
 * passed validation at `generate` time can later be edited to add e.g. `LD_PRELOAD` and
 * bypass that one-time check. This re-validates the command, arguments, and environment
 * variable names (stdio) or URL and headers (http/sse) on every load, mirroring
 * `mcp_execution_core::validate_server_config` (`command.rs`) to the same depth for every
 * transport — including its denial-of-service size/count ceilings
 * ({@link validateStdioSizeBounds}/{@link validateNetworkSizeBounds}), checked before the
 * command-injection-specific checks, exactly as the Rust source of truth orders them. Fails
 * closed by throwing rather than silently stripping the offending value, so an invalid config
 * surfaces as a clear error instead of an unexpectedly sanitized spawn.
 *
 * Two checks in the Rust source of truth are intentionally *not* mirrored here: absolute-path
 * existence/executability (would require a blocking filesystem call this bridge avoids; a bad
 * path instead surfaces as a `spawn` failure) and `connect_timeout`/`discover_timeout` bounds
 * (not part of the JSON-RPC protocol this bridge speaks, so there is no timeout value to
 * validate).
 *
 * This bridge only ever spawns a subprocess (stdio transport) — it has no http/sse client of
 * its own — so a validated http/sse config is still rejected as unsupported afterward. The
 * validation runs first regardless, so the error a caller sees names the actual problem (a
 * bad URL scheme, an unsafe header) when one exists, and the "unsupported transport" message
 * is reserved for a config that is otherwise well-formed. This also means the validation
 * logic is already correct and tested for when the bridge gains real http/sse tool-call
 * support (see issue #221 item 2).
 *
 * @param config - The server configuration to validate
 * @param serverId - Server identifier, used in error messages
 * @throws {Error} If the config fails validation for its transport, or the transport is not
 *   "stdio" (even if otherwise valid — see above)
 */
function validateServerConfig(config: ServerConfig, serverId: string): void {
  const transport = config.transport ?? 'stdio';

  // Validate http/sse configs to the same depth as the Rust source of truth before
  // rejecting them as unsupported below, so a malformed URL/header is reported precisely
  // rather than masked by the generic "unsupported transport" message.
  if (transport === 'http' || transport === 'sse') {
    validateNetworkConfig(config, serverId);
  }

  if (transport !== 'stdio') {
    throw new Error(
      `Server '${serverId}' is configured for '${transport}' transport, but this generated ` +
      `runtime bridge only supports stdio transport servers.`
    );
  }

  validateStdioSizeBounds(config, serverId);

  validateCommandString(config.command, `command for server '${serverId}'`);

  const args: unknown = config.args ?? [];
  if (!Array.isArray(args)) {
    throw new Error(`args for server '${serverId}' must be an array of strings`);
  }
  args.forEach((arg, idx) => {
    validateCommandString(arg, `argument ${idx} for server '${serverId}'`);
  });

  for (const [envName] of recordEntries(config.env, `env for server '${serverId}'`)) {
    validateEnvName(envName);
  }
}

/**
 * Load server configuration from filesystem
 *
 * Looks for config in ~/.claude/mcp.json under mcpServers.{serverId}. The
 * resolved configuration is validated via {@link validateServerConfig} before
 * being returned, since this file can be edited after code generation.
 *
 * @param serverId - Server identifier (e.g., "github", "gdrive")
 * @returns Server configuration
 * @throws {Error} If config file not found, serverId not in config, or the
 *   resolved configuration fails security validation
 */
async function loadServerConfig(serverId: string): Promise<ServerConfig> {
  const configPath = join(homedir(), '.claude', 'mcp.json');

  try {
    const content = await readFile(configPath, 'utf-8');
    const config = JSON.parse(content);

    if (!config.mcpServers || !config.mcpServers[serverId]) {
      throw new Error(
        `Server '${serverId}' not found in config.\n` +
        `Available servers: ${Object.keys(config.mcpServers || {}).join(', ')}\n` +
        `Config file: ${configPath}`
      );
    }

    const serverConfig: ServerConfig = config.mcpServers[serverId];
    validateServerConfig(serverConfig, serverId);
    return serverConfig;
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
      throw new Error(
        `MCP configuration file not found: ${configPath}\n` +
        `Create it with server configurations under 'mcpServers' key.\n` +
        `See examples/mcp.json.example for reference.`
      );
    }
    throw error;
  }
}

/**
 * Default timeout, in milliseconds, for a single JSON-RPC round trip in
 * {@link sendRequest}. Overridable via the `MCPBRIDGE_REQUEST_TIMEOUT_MS`
 * environment variable.
 */
const DEFAULT_REQUEST_TIMEOUT_MS = 30_000;

/**
 * Configured request timeout, in milliseconds. Falls back to
 * {@link DEFAULT_REQUEST_TIMEOUT_MS} if `MCPBRIDGE_REQUEST_TIMEOUT_MS` is unset, empty, or
 * not a positive number.
 */
const REQUEST_TIMEOUT_MS = (() => {
  const raw = process.env.MCPBRIDGE_REQUEST_TIMEOUT_MS;
  const parsed = raw ? Number(raw) : NaN;
  return Number.isFinite(parsed) && parsed > 0 ? parsed : DEFAULT_REQUEST_TIMEOUT_MS;
})();

/**
 * Request message shapes {@link sendRequest} may send: both carry a JSON-RPC `id` used to
 * match the eventual response.
 */
type MCPRequestMessage = MCPToolCallRequest | MCPInitializeRequest;

/**
 * Tears down a connection after it can no longer serve requests: rejects every request still
 * awaiting a response, and removes the connection from {@link activeProcesses} and — only if
 * the cache still points at this exact connection attempt — {@link serverConnections}. This
 * identity check mirrors the one in {@link getConnection}'s catch handler: without it, a
 * connection that already lost the race to a newer one (see `exit`-before-`close` ordering)
 * would evict the newer, live connection from the cache instead of just itself.
 *
 * @param serverId - Server identifier the connection was cached under
 * @param connection - The connection being torn down
 * @param error - Rejection reason for any still-pending requests
 * @param ownPromise - The {@link serverConnections} promise this connection was created from
 */
function teardownConnection(
  serverId: string,
  connection: ServerConnection,
  error: Error,
  ownPromise: Promise<ServerConnection>
): void {
  activeProcesses.delete(connection.process);
  if (serverConnections.get(serverId) === ownPromise) {
    serverConnections.delete(serverId);
  }

  const pendingRequests = [...connection.pending.values()];
  for (const pendingRequest of pendingRequests) {
    pendingRequest.reject(error);
  }
}

/**
 * Attaches the single, shared stdout listener for a connection: parses newline-delimited
 * JSON-RPC messages and demultiplexes each response to the pending request with the matching
 * `id`, so concurrent {@link sendRequest} calls on the same connection never receive each
 * other's response.
 *
 * Uses `setEncoding('utf8')` rather than manually decoding `Buffer` chunks, so multi-byte
 * UTF-8 characters split across chunk boundaries are reassembled correctly instead of
 * producing replacement characters that fail `JSON.parse`.
 *
 * @param connection - The connection whose stdout should be dispatched
 * @param serverId - Server identifier, used for debug logging and connection teardown
 * @param getOwnPromise - Returns the {@link serverConnections} promise this connection was
 *   created from, threaded through to {@link teardownConnection} so a stale teardown never
 *   evicts a newer connection cached under the same `serverId`
 */
function attachResponseDispatcher(
  connection: ServerConnection,
  serverId: string,
  getOwnPromise: () => Promise<ServerConnection>
): void {
  const stdout = connection.process.stdout!;
  stdout.setEncoding('utf8');
  let buffer = '';

  stdout.on('data', (chunk: string): void => {
    buffer += chunk;
    const lines = buffer.split('\n');
    buffer = lines.pop() ?? '';

    for (const line of lines) {
      const trimmed = line.trim();
      if (trimmed.length === 0) continue;

      let parsed: unknown;
      try {
        parsed = JSON.parse(trimmed);
      } catch {
        // A complete, newline-terminated line that isn't valid JSON-RPC — drop it rather
        // than waiting for more data, since no more data will make this line parse.
        debug('Dropping unparseable line from server output:', trimmed);
        continue;
      }

      // Only object messages carrying an `id` are responses; primitive JSON (e.g. a bare
      // `null` line) and notifications are ignored the same way an unparseable line is —
      // `'id' in parsed` would otherwise throw a TypeError on a non-object `parsed`.
      if (typeof parsed !== 'object' || parsed === null || !('id' in parsed)) continue;

      const message = parsed as MCPToolCallResponse;
      const pendingRequest = connection.pending.get(message.id);
      if (!pendingRequest) {
        debug(`Received response for unknown or already-settled request id ${message.id}`);
        continue;
      }
      pendingRequest.resolve(message);
    }
  });

  stdout.on('error', (error: Error): void => {
    debug(`stdout error for server ${serverId}:`, error);
    teardownConnection(serverId, connection, error, getOwnPromise());
  });
}

/**
 * Sends a JSON-RPC request on a connection and resolves once the response with the matching
 * `id` arrives via {@link attachResponseDispatcher}, guarding against the two ways this could
 * otherwise hang forever: the server process closing before ever responding, and a server
 * that simply never replies.
 *
 * The pending-request entry is registered before the request is written to stdin, and is
 * always removed — on resolve, reject, or timeout — so the pending map never grows unbounded.
 *
 * @param connection - The connection to send the request on
 * @param request - The JSON-RPC request to send
 * @param timeoutMs - Milliseconds to wait for a response before rejecting; defaults to
 *   {@link REQUEST_TIMEOUT_MS}
 * @returns Parsed JSON-RPC response matching the request's `id`
 * @throws {Error} If writing to stdin fails, the connection closes before responding, or
 *   `timeoutMs` elapses with no response
 */
async function sendRequest(
  connection: ServerConnection,
  request: MCPRequestMessage,
  timeoutMs: number = REQUEST_TIMEOUT_MS
): Promise<MCPToolCallResponse> {
  return new Promise((resolve, reject) => {
    const id = request.id;
    let settled = false;

    const settle = (fn: () => void): void => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      connection.pending.delete(id);
      fn();
    };

    const timer = setTimeout(() => {
      settle(() =>
        reject(new Error(`Timed out after ${timeoutMs}ms waiting for a response from the MCP server`))
      );
    }, timeoutMs);

    connection.pending.set(id, {
      resolve: (message) => settle(() => resolve(message)),
      reject: (error) => settle(() => reject(error))
    });

    try {
      connection.process.stdin!.write(JSON.stringify(request) + '\n');
    } catch (error) {
      settle(() => reject(error instanceof Error ? error : new Error(String(error))));
    }
  });
}

/**
 * Spawns the server process for `serverId`, wires up its response dispatcher and lifecycle
 * handlers, and completes the JSON-RPC `initialize` handshake.
 *
 * Split out of {@link getConnection} so the latter can cache this function's promise —
 * rather than only its resolved value — letting concurrent cold-start callers await the same
 * in-flight setup instead of each spawning a competing child process.
 *
 * @param serverId - Server identifier
 * @param getOwnPromise - Returns the {@link serverConnections} promise wrapping this very call,
 *   so the process lifecycle handlers registered below can pass it to
 *   {@link teardownConnection} for its cache-identity check. The promise doesn't exist yet when
 *   this function starts running (the caller creates it from this call's return value), but by
 *   the time any of these handlers fire the caller has assigned it, so the closure resolves it
 *   correctly.
 * @returns The newly established connection
 * @throws {Error} If the config fails validation, or the server fails to initialize
 */
async function createConnection(
  serverId: string,
  getOwnPromise: () => Promise<ServerConnection>
): Promise<ServerConnection> {
  const config = await loadServerConfig(serverId);

  const childProcess = spawn(config.command, config.args, {
    stdio: ['pipe', 'pipe', 'inherit'],
    env: { ...process.env, ...config.env },
    cwd: config.cwd
  });
  activeProcesses.add(childProcess);

  const connection: ServerConnection = { process: childProcess, pending: new Map() };
  attachResponseDispatcher(connection, serverId, getOwnPromise);

  // An async EPIPE reported here (rather than as a synchronous throw from `stdin.write`)
  // would otherwise leave the pending request(s) unrejected until they time out; tear down
  // the same way as other stream/process failures so they fail fast instead.
  //
  // EPIPE specifically means the child's stdin has already closed, which only happens once
  // the child itself has exited — the same underlying condition the 'close' handler below
  // reports. Whichever of the two fires first wins the race (teardownConnection only rejects
  // each still-pending request once), so both must describe it the same way; otherwise the
  // rejection message a caller sees would depend on unpredictable event-loop timing that
  // differs across platforms.
  childProcess.stdin!.on('error', (error: NodeJS.ErrnoException) => {
    debug(`stdin error for server ${serverId}:`, error);
    const message =
      error.code === 'EPIPE'
        ? 'MCP server process exited before responding (stdin closed)'
        : `MCP server stdin error: ${error.message}`;
    teardownConnection(serverId, connection, new Error(message), getOwnPromise());
  });

  childProcess.on('error', (error) => {
    debug(`Server process error for ${serverId}:`, error);
    teardownConnection(
      serverId,
      connection,
      new Error(`MCP server process error: ${error.message}`),
      getOwnPromise()
    );
  });

  // 'close' (not 'exit') fires once stdio has fully drained, so a response already sitting
  // in the OS pipe buffer is delivered to attachResponseDispatcher's listener before pending
  // requests are rejected here.
  childProcess.on('close', (code, signal) => {
    debug(`Server ${serverId} closed (code ${code}, signal ${signal})`);
    teardownConnection(
      serverId,
      connection,
      new Error(
        `MCP server process exited before responding (code ${code ?? 'null'}, ` +
        `signal ${signal ?? 'null'})`
      ),
      getOwnPromise()
    );
  });

  const initRequest: MCPInitializeRequest = {
    jsonrpc: '2.0',
    id: requestIdCounter++,
    method: 'initialize',
    params: {
      protocolVersion: '2024-11-05',
      capabilities: {
        tools: {}
      },
      clientInfo: {
        name: 'mcp-execution-bridge',
        version: '0.4.0'
      }
    }
  };

  debug('Sending initialize request:', JSON.stringify(initRequest));
  try {
    const initResponse = await sendRequest(connection, initRequest);
    debug('Received initialize response:', JSON.stringify(initResponse));

    if (initResponse.error) {
      throw new Error(`Server initialization failed: ${initResponse.error.message}`);
    }
  } catch (error) {
    childProcess.kill();
    throw new Error(`Failed to initialize server ${serverId}: ${error}`);
  }

  debug(`Connected to server: ${serverId}`);
  return connection;
}

/**
 * Returns whether `childProcess` is still running.
 *
 * Checking `exitCode` alone misses a process that was terminated by a signal without an exit
 * code of its own (Node sets `signalCode` instead in that case), which would otherwise
 * misclassify a signal-killed process as still alive.
 *
 * @param childProcess - The child process to check
 */
function isProcessAlive(childProcess: ChildProcess): boolean {
  return childProcess.exitCode === null && childProcess.signalCode === null;
}

/**
 * Connect to an MCP server or reuse an existing connection.
 *
 * Implements connection caching: the first call for a given `serverId` spawns the server
 * process, subsequent calls reuse the same connection. Caches the in-flight
 * {@link createConnection} promise (see {@link serverConnections}) so concurrent calls on a
 * cold `serverId` share one connection attempt instead of racing to spawn duplicate
 * processes.
 *
 * @param serverId - Server identifier
 * @returns Active server connection
 */
async function getConnection(serverId: string): Promise<ServerConnection> {
  const cached = serverConnections.get(serverId);
  if (cached) {
    try {
      const connection = await cached;

      if (isProcessAlive(connection.process)) {
        debug(`Reusing connection to server: ${serverId}`);
        return connection;
      }

      debug(`Cached connection to ${serverId} is dead, reconnecting`);
      // Only clear the cache if it still points at this dead attempt — a concurrent caller
      // may have already replaced it with a newer, live one.
      if (serverConnections.get(serverId) === cached) {
        serverConnections.delete(serverId);
      }
    } catch (error) {
      if (serverConnections.get(serverId) === cached) {
        serverConnections.delete(serverId);
      }
      throw error;
    }
  }

  debug(`Connecting to server: ${serverId}`);
  const connectionPromise: Promise<ServerConnection> = createConnection(serverId, () => connectionPromise);
  serverConnections.set(serverId, connectionPromise);

  try {
    return await connectionPromise;
  } catch (error) {
    // Only clear the cache if it still points at this failed attempt — a concurrent caller
    // may have already replaced it with a newer one.
    if (serverConnections.get(serverId) === connectionPromise) {
      serverConnections.delete(serverId);
    }
    throw error;
  }
}

/**
 * Call an MCP tool on a server
 *
 * This is the main entry point for tool execution. It:
 * 1. Gets or creates server connection
 * 2. Sends JSON-RPC tool call request
 * 3. Waits for response
 * 4. Extracts and returns result
 *
 * @param serverId - Server identifier (e.g., "github")
 * @param toolName - Tool name as defined by MCP server (e.g., "create_issue")
 * @param params - Tool parameters as object
 * @returns Tool execution result
 * @throws {Error} If tool execution fails or returns error
 *
 * @example
 * ```typescript
 * const result = await callMCPTool('github', 'create_issue', {
 *   owner: 'user',
 *   repo: 'project',
 *   title: 'Bug report'
 * });
 * console.log(result); // { number: 123, url: '...', state: 'open' }
 * ```
 */
export async function callMCPTool(
  serverId: string,
  toolName: string,
  params: Record<string, unknown>
): Promise<unknown> {
  debug(`Calling tool: ${serverId}.${toolName}`, params);

  const connection = await getConnection(serverId);

  const request: MCPToolCallRequest = {
    jsonrpc: '2.0',
    id: requestIdCounter++,
    method: 'tools/call',
    params: {
      name: toolName,
      arguments: params
    }
  };

  debug('Sending tool call request:', JSON.stringify(request));
  const response = await sendRequest(connection, request);
  debug('Received tool call response:', JSON.stringify(response));

  // Handle errors
  if (response.error) {
    throw new Error(
      `Tool execution failed: ${response.error.message}\n` +
      `Tool: ${serverId}.${toolName}\n` +
      `Error code: ${response.error.code}`
    );
  }

  // Extract result
  if (!response.result) {
    throw new Error(`No result in response from ${serverId}.${toolName}`);
  }

  // Handle error flag in result. `content` legitimately defaults to `[]` server-side (see
  // MCPToolCallResponse), so this must not assume a first element exists. When `content` has no
  // usable text, fall back to `structuredContent` before giving up: a structured error response
  // can carry real detail that plain `content` omits.
  if (response.result.isError) {
    const errorContent = response.result.content?.[0];
    const errorMessage =
      errorContent?.text ||
      (response.result.structuredContent != null
        ? JSON.stringify(response.result.structuredContent)
        : 'Unknown error');
    throw new Error(`Tool returned error: ${errorMessage}`);
  }

  const content = response.result.content;

  // `structuredContent`-only responses (spec 2025-06-18+): surfaced as a distinct case rather
  // than falling through to the content[0] handling below, which it was never meant to reach.
  // `!= null` is deliberate (not `!== undefined`): a literal `null` must be treated the same as
  // an absent field rather than returned as if it were real structured data.
  if ((!content || content.length === 0) && response.result.structuredContent != null) {
    return response.result.structuredContent;
  }

  // A tool that legitimately has no output (e.g. a side-effect-only action) is indistinguishable
  // here from a misbehaving server that forgot to populate `content`: per the MCP spec,
  // `CallToolResult::success(vec![])` is a valid empty-but-successful result. We treat it as an
  // error until the per-tool Result type generated in tool.ts.hbs (currently
  // `Record<string, unknown> | unknown[] | string`) gains a void/undefined member to represent
  // this case explicitly.
  if (!content || content.length === 0) {
    throw new Error(`Tool ${serverId}.${toolName} returned no content and no structuredContent`);
  }

  // Extract content from response
  const firstContent = content[0];

  if (!firstContent) {
    // `content[0]` is present but null/falsy — a malformed entry, distinct from the
    // empty/absent `content` case handled above. Prefer a populated `structuredContent` over
    // failing, since the server may still have supplied usable structured data alongside a
    // malformed content array.
    if (response.result.structuredContent != null) {
      return response.result.structuredContent;
    }
    throw new Error(
      `Tool ${serverId}.${toolName} returned an invalid content[0] (null) and no structuredContent`
    );
  }

  if (firstContent.type === 'text' && firstContent.text) {
    // Try to parse as JSON if it looks like JSON
    if (firstContent.text.trim().startsWith('{') || firstContent.text.trim().startsWith('[')) {
      try {
        return JSON.parse(firstContent.text);
      } catch {
        // Not valid JSON, return as string
        return firstContent.text;
      }
    }
    return firstContent.text;
  }

  // Return the entire content object for non-text types
  return firstContent;
}

/**
 * Close all server connections
 *
 * Should be called during graceful shutdown to clean up processes.
 * This is automatically called when the process exits.
 *
 * @example
 * ```typescript
 * process.on('SIGINT', async () => {
 *   await closeAllConnections();
 *   process.exit(0);
 * });
 * ```
 */
export async function closeAllConnections(): Promise<void> {
  debug('Closing all connections');

  // Signal every tracked child process synchronously and immediately, before awaiting
  // anything: a still-initializing server's connection-creation promise can take up to
  // REQUEST_TIMEOUT_MS to settle, and awaiting each one in turn (as before) would both stall
  // shutdown on a slow server and delay killing every other server behind it.
  for (const childProcess of activeProcesses) {
    if (!childProcess.killed) {
      childProcess.kill('SIGTERM');
    }
  }

  // Best-effort: let in-flight connection attempts settle so their own teardown/cleanup runs,
  // concurrently rather than sequentially. The kill signals above have already been sent
  // regardless of how long (or whether) these resolve.
  await Promise.allSettled([...serverConnections.values()]);
  serverConnections.clear();
}

// Cleanup on process exit. Synchronous — cannot await connection promises — so this walks
// activeProcesses (populated synchronously at spawn time) rather than serverConnections.
process.on('exit', () => {
  for (const childProcess of activeProcesses) {
    if (!childProcess.killed) {
      childProcess.kill('SIGTERM');
    }
  }
});

// Graceful shutdown on SIGINT/SIGTERM
process.on('SIGINT', () => {
  closeAllConnections().then(() => process.exit(0));
});

process.on('SIGTERM', () => {
  closeAllConnections().then(() => process.exit(0));
});
