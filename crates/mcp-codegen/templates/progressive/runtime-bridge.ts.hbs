/**
 * MCP Runtime Bridge - thin client of the mcp-execution helper
 *
 * Tool files call {@link callMCPTool}; this module forwards each call to the `mcp-execution-cli`
 * helper over a newline-delimited JSON channel and returns the extracted result. The helper owns
 * every MCP connection: transports, validation, result extraction and limits all live there, so
 * this file only frames requests, matches responses by id and maps failures to
 * {@link McpToolError}.
 *
 * The channel is, in order of preference:
 * 1. the one `mcp-execution-cli run` registered for this script (the preload hands it over under
 *    the well-known global symbol {@link CHANNEL_KEY}). It is not a security boundary: any script
 *    code can fetch the raw socket, and a script that writes to it can corrupt only the calls of
 *    its own run;
 * 2. a hidden `mcp-execution-cli helper` process spawned over stdio, for a tool file run directly
 *    with `node tool.ts '{...}'`. The binary is `$MCP_EXECUTION_CLI` when set, else found on PATH.
 *
 * @module mcp-bridge
 */

import { spawn } from 'child_process';
import { posix, win32 } from 'path';
import { closeSync, constants, fstatSync, openSync, statSync, writeSync } from 'fs';

/** Version of the helper protocol this bridge speaks; the helper must answer the same one. */
const HELPER_PROTOCOL_VERSION = {{helper_protocol_version}};

/** Longest protocol line accepted from, or sent to, the helper, in bytes. */
const MAX_HELPER_LINE_BYTES = {{max_helper_line_bytes}};

/** Environment variable announcing a runner channel; present only under `mcp-execution-cli run`. */
const HELPER_ENV = '{{{helper_env}}}';

/** Environment variable carrying the runner channel's token; never forwarded to a spawned helper. */
const HELPER_TOKEN_ENV = '{{{helper_token_env}}}';

/**
 * Non-secret marker every process under `mcp-execution-cli run` inherits, workers and children
 * included. It only forbids the spawn fallback; it can never stand in for the channel.
 */
const RUN_MARKER_ENV = '{{{run_marker_env}}}';

/** Environment variable naming the `mcp-execution-cli` binary to spawn as the helper. */
const CLI_PATH_ENV = '{{{cli_path_env}}}';

/** Binary looked up on PATH only when {@link CLI_PATH_ENV} is not set; a set variable never falls back. */
const DEFAULT_CLI_NAME = 'mcp-execution-cli';

/** Global key under which the `run` preload registers the helper channel. */
const CHANNEL_KEY = Symbol.for('{{{helper_channel_key}}}');

/**
 * Bounds and key rule of the opt-in observed-shape recorder, rendered from
 * `mcp-execution-codegen`'s `observed` constants so the Rust reader and this recorder apply
 * identical limits.
 */
const OBSERVED_SHAPE_MAX_DEPTH = {{observed_shape_max_depth}};
const OBSERVED_SHAPE_MAX_KEYS = {{observed_shape_max_keys}};
const OBSERVED_SHAPE_MAX_KEY_LEN = {{observed_shape_max_key_len}};
const OBSERVED_SHAPE_MAX_LINE_BYTES = {{observed_shape_max_line_bytes}};
const OBSERVED_KEY_REGEX = new RegExp('{{{identifier_pattern}}}');

/** Debug mode flag (set via the MCPBRIDGE_DEBUG environment variable). */
const DEBUG = process.env.MCPBRIDGE_DEBUG === '1';

function debug(...args: unknown[]): void {
  if (DEBUG) {
    console.error('[mcp-bridge]', ...args);
  }
}

/** Why a tool call failed. `write_skipped` is a dry run declining to execute a write call. */
export type McpToolErrorKind = 'tool_error' | 'rpc_error' | 'call_failed' | 'write_skipped';

const ERROR_KINDS: readonly McpToolErrorKind[] = [
  'tool_error',
  'rpc_error',
  'call_failed',
  'write_skipped'
];

/** Server text as the helper sanitized it, and whether the helper cut it. */
interface ServerText {
  text: string;
  truncated: boolean;
}

/**
 * The only error {@link callMCPTool} throws.
 *
 * `message` is fixed text written by the bridge or the helper. Anything the MCP server said is
 * neutralized by the helper and kept only in `serverMessage`, so a hostile server cannot inject
 * text into a log line or a prompt through `message`.
 */
export class McpToolError extends Error {
  readonly kind: McpToolErrorKind;
  readonly serverMessage?: string;
  readonly serverMessageTruncated: boolean;

  constructor(kind: McpToolErrorKind, message: string, server?: ServerText) {
    super(message);
    this.name = 'McpToolError';
    this.kind = kind;
    this.serverMessageTruncated = false;
    if (server !== undefined) {
      this.serverMessage = server.text;
      this.serverMessageTruncated = server.truncated;
    }
  }
}

/** JSON-Schema fragment of the JSON types seen in a result, never of its values. */
type ObservedShape =
  | { type: 'null' | 'boolean' | 'number' | 'integer' | 'string' }
  | { type: 'array'; items?: ObservedShape }
  | {
      type: 'object';
      properties?: Record<string, ObservedShape>;
      additionalProperties?: ObservedShape;
    };

function isRecordableKey(key: string): boolean {
  return key.length <= OBSERVED_SHAPE_MAX_KEY_LEN && OBSERVED_KEY_REGEX.test(key);
}

/**
 * Shape of `value`. An object keeps its keys only when it has few keys and every key is a short
 * identifier; otherwise (IDs, emails, paths used as map keys) only the shape of its first value
 * is kept, so key text that may be data never reaches the record.
 */
function observedShapeOf(value: unknown, depth: number): ObservedShape {
  if (value === null) return { type: 'null' };
  if (typeof value === 'boolean') return { type: 'boolean' };
  if (typeof value === 'number') return { type: Number.isInteger(value) ? 'integer' : 'number' };
  if (typeof value === 'string') return { type: 'string' };

  if (Array.isArray(value)) {
    if (depth >= OBSERVED_SHAPE_MAX_DEPTH || value.length === 0) return { type: 'array' };
    return { type: 'array', items: observedShapeOf(value[0], depth + 1) };
  }

  if (typeof value === 'object') {
    const record = value as Record<string, unknown>;
    const keys = Object.keys(record);
    if (depth >= OBSERVED_SHAPE_MAX_DEPTH || keys.length === 0) return { type: 'object' };
    if (keys.length <= OBSERVED_SHAPE_MAX_KEYS && keys.every(isRecordableKey)) {
      return {
        type: 'object',
        properties: Object.fromEntries(
          keys.map((key) => [key, observedShapeOf(record[key], depth + 1)])
        )
      };
    }
    return { type: 'object', additionalProperties: observedShapeOf(record[keys[0]!], depth + 1) };
  }

  return { type: 'null' };
}

/**
 * Appends `line` to `path` only when that is safe: the path is opened without following a
 * symlink, and an existing file must be a regular file owned by this user and closed to group
 * and others (`mode` in `openSync` applies on creation only). Returns whether it was written.
 */
function appendPrivately(path: string, line: string): boolean {
  // O_NONBLOCK keeps an open of a FIFO from waiting for a reader; the fstat below rejects it.
  const flags =
    constants.O_WRONLY |
    constants.O_APPEND |
    constants.O_CREAT |
    (constants.O_NOFOLLOW ?? 0) |
    (constants.O_NONBLOCK ?? 0);
  const fd = openSync(path, flags, 0o600);
  try {
    const stat = fstatSync(fd);
    const uid = process.getuid?.();
    if (!stat.isFile() || (uid !== undefined && (stat.uid !== uid || (stat.mode & 0o077) !== 0))) {
      return false;
    }
    writeSync(fd, line);
    return true;
  } finally {
    closeSync(fd);
  }
}

/**
 * Appends the shape of a successful result to the file named by `MCPBRIDGE_OBSERVE_SHAPES`, if
 * set. Opt-in and best effort: a failure or an unsafe target is only debug-logged and never
 * affects the call.
 */
function recordObservedShape(serverId: string, toolName: string, value: unknown): void {
  const path = process.env.MCPBRIDGE_OBSERVE_SHAPES;
  if (!path) return;
  try {
    const line =
      JSON.stringify({ server: serverId, tool: toolName, shape: observedShapeOf(value, 1) }) + '\n';
    if (byteLength(line) > OBSERVED_SHAPE_MAX_LINE_BYTES) {
      debug('Observed shape exceeds the line bound, not recorded');
      return;
    }
    if (!appendPrivately(path, line)) {
      debug('Observed-shape file is not a private regular file owned by this user, not recorded');
    }
  } catch (error) {
    debug('Could not record observed shape:', error);
  }
}

/** UTF-8 byte length of `value`, the unit every size bound here is defined in. */
function byteLength(value: string): number {
  return Buffer.byteLength(value, 'utf8');
}

/** Which part of a tool response carries the result a caller wants. */
export type ResultSource = 'structured' | 'content';

/** One request line to the helper. */
interface HelperRequest {
  id: number;
  server: string;
  tool: string;
  arguments: Record<string, unknown>;
  result: ResultSource;
}

/** A call awaiting its response line. */
interface PendingCall {
  resolve: (value: unknown) => void;
  reject: (error: McpToolError) => void;
}

/** The pieces of a Node duplex channel the bridge relies on. */
interface Wire {
  readable: NodeJS.ReadableStream;
  writable: NodeJS.WritableStream;
  /** Keeps the event loop alive (`true`) or lets it exit (`false`). */
  setRef(active: boolean): void;
  destroy(): void;
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null && !Array.isArray(value);
}

/** Calls `ref()`/`unref()` on a stream or handle when it has them (sockets and pipes do). */
function refHandle(handle: unknown, active: boolean): void {
  if (typeof handle !== 'object' || handle === null) return;
  const method = (handle as Record<string, unknown>)[active ? 'ref' : 'unref'];
  if (typeof method === 'function') method.call(handle);
}

function channelClosed(reason: string): McpToolError {
  return new McpToolError('call_failed', `helper channel closed: ${reason}`);
}

/** Maps the `error` member of a response line to an {@link McpToolError}. */
function toolErrorOf(error: Record<string, unknown>): McpToolError {
  const kind = ERROR_KINDS.find((candidate) => candidate === error.kind) ?? 'call_failed';
  const message = typeof error.message === 'string' ? error.message : 'Tool call failed';
  const text = error.server_message;
  const server: ServerText | undefined =
    typeof text === 'string'
      ? { text, truncated: error.server_message_truncated === true }
      : undefined;
  return new McpToolError(kind, message, server);
}

/**
 * The single helper channel of this process: frames requests, matches responses to pending calls
 * by id and keeps the event loop alive only while a call is pending.
 *
 * One connection serves the whole process and is never re-created: once it fails, every pending
 * and later call rejects with "helper channel closed".
 */
class HelperConnection {
  private readonly pending = new Map<number, PendingCall>();
  private nextId = 1;
  private inflight = 0;
  private failure: string | undefined;
  private partial: Buffer[] = [];
  private partialBytes = 0;
  private helloAnswered = false;
  private readonly ready: Promise<void>;
  private markReady: () => void = () => {};
  private readonly wire: Wire;

  /**
   * Written without parameter properties: tool files run under Node's type-stripping, which
   * supports erasable syntax only.
   *
   * @param wire - The duplex channel to the helper
   * @param sendHello - Whether this side still has to send the hello line (the preload already
   *   sent it on a registered channel)
   */
  constructor(wire: Wire, sendHello: boolean) {
    this.wire = wire;
    this.ready = new Promise((resolve) => {
      this.markReady = resolve;
    });
    wire.setRef(false);
    wire.readable.on('data', (chunk: Buffer | string) => this.onData(chunk));
    wire.readable.on('end', () => this.fail('the helper closed the channel'));
    wire.readable.on('close', () => this.fail('the helper closed the channel'));
    wire.readable.on('error', (error: Error) => this.fail(error.message));
    wire.writable.on('error', (error: Error) => this.fail(error.message));
    if (sendHello) {
      this.write(JSON.stringify({ v: HELPER_PROTOCOL_VERSION }) + '\n');
    }
  }

  /** Rejects every pending call and refuses later ones. Idempotent: the first reason wins. */
  fail(reason: string): void {
    if (this.failure !== undefined) return;
    debug('Helper channel failed:', reason);
    this.failure = reason;
    const pending = [...this.pending.values()];
    this.pending.clear();
    for (const call of pending) call.reject(channelClosed(reason));
    this.markReady();
    this.wire.destroy();
  }

  /** Sends one call and resolves with its extracted value (`undefined` for an empty success). */
  async call(
    server: string,
    tool: string,
    args: Record<string, unknown>,
    result: ResultSource
  ): Promise<unknown> {
    if (this.failure !== undefined) throw channelClosed(this.failure);

    const id = this.nextId++;
    const request: HelperRequest = { id, server, tool, arguments: args, result };
    const line = JSON.stringify(request) + '\n';
    if (byteLength(line) > MAX_HELPER_LINE_BYTES) {
      throw new McpToolError(
        'call_failed',
        `Request for ${server}.${tool} exceeds ${MAX_HELPER_LINE_BYTES} bytes`
      );
    }

    this.inflight += 1;
    this.wire.setRef(true);
    try {
      await this.ready;
      if (this.failure !== undefined) throw channelClosed(this.failure);

      debug(`Calling tool: ${server}.${tool}`, args);
      const outcome = new Promise<unknown>((resolve, reject: (error: McpToolError) => void) => {
        this.pending.set(id, { resolve, reject });
      });
      this.write(line);
      return await outcome;
    } finally {
      this.inflight -= 1;
      if (this.inflight === 0) this.wire.setRef(false);
    }
  }

  private write(line: string): void {
    this.wire.writable.write(line, (error?: Error | null) => {
      if (error) this.fail(error.message);
    });
  }

  private onData(chunk: Buffer | string): void {
    const data = typeof chunk === 'string' ? Buffer.from(chunk, 'utf8') : chunk;
    let start = 0;
    while (this.failure === undefined) {
      const newline = data.indexOf(0x0a, start);
      if (newline === -1) {
        this.append(data.subarray(start));
        return;
      }
      this.append(data.subarray(start, newline));
      if (this.failure !== undefined) return;
      const line = Buffer.concat(this.partial).toString('utf8');
      this.partial = [];
      this.partialBytes = 0;
      this.onLine(line);
      start = newline + 1;
    }
  }

  private append(piece: Buffer): void {
    this.partialBytes += piece.length;
    if (this.partialBytes > MAX_HELPER_LINE_BYTES) {
      this.fail(`a helper line exceeds ${MAX_HELPER_LINE_BYTES} bytes`);
      return;
    }
    this.partial.push(piece);
  }

  private onLine(line: string): void {
    const trimmed = line.trim();
    if (trimmed.length === 0) return;

    let message: unknown;
    try {
      message = JSON.parse(trimmed);
    } catch {
      this.fail('the helper sent a line that is not JSON');
      return;
    }
    if (!isRecord(message)) {
      this.fail('the helper sent a line that is not a JSON object');
      return;
    }

    if (this.helloAnswered) {
      this.onResponse(message);
    } else {
      this.onHelloReply(message);
    }
  }

  private onHelloReply(reply: Record<string, unknown>): void {
    if (reply.v !== HELPER_PROTOCOL_VERSION) {
      this.fail(
        `the helper speaks protocol version ${String(reply.v)} but this bridge speaks ` +
          `${HELPER_PROTOCOL_VERSION}; regenerate the servers with the installed mcp-execution-cli`
      );
      return;
    }
    this.helloAnswered = true;
    this.markReady();
  }

  private onResponse(response: Record<string, unknown>): void {
    const id = response.id;
    // Request ids start at 1, so id 0 is the helper's answer to a line it could not parse or
    // accept: the channel is out of step and cannot be trusted any more.
    if (id === 0) {
      this.fail('the helper rejected a request it could not process');
      return;
    }
    const call = typeof id === 'number' ? this.pending.get(id) : undefined;
    if (typeof id !== 'number' || call === undefined) {
      debug('Response for an unknown or settled request id:', id);
      return;
    }
    this.pending.delete(id);

    if (isRecord(response.error)) {
      call.reject(toolErrorOf(response.error));
    } else if ('value' in response) {
      call.resolve(response.value);
    } else if (response.empty === true) {
      call.resolve(undefined);
    } else {
      call.reject(new McpToolError('call_failed', 'The helper sent a malformed response'));
    }
  }
}

/** Wraps the duplex stream the `run` preload registered for this process. */
function registeredWire(channel: unknown): Wire {
  if (
    typeof channel !== 'object' ||
    channel === null ||
    typeof (channel as Record<string, unknown>).on !== 'function' ||
    typeof (channel as Record<string, unknown>).write !== 'function' ||
    typeof (channel as Record<string, unknown>).destroy !== 'function'
  ) {
    throw new McpToolError('call_failed', 'The registered helper channel is not a stream');
  }
  const stream = channel as NodeJS.ReadWriteStream & { destroy(): void };
  return {
    readable: stream,
    writable: stream,
    setRef: (active) => refHandle(stream, active),
    destroy: () => stream.destroy()
  };
}

/** Message for a configured {@link CLI_PATH_ENV} that cannot be used; never repeats the value. */
function unusableCliMessage(reason: string): string {
  return `${CLI_PATH_ENV} is set but unusable: ${reason}`;
}

/** Whether `path` is an existing regular file. */
function isExistingFile(path: string): boolean {
  try {
    return statSync(path).isFile();
  } catch {
    return false;
  }
}

/**
 * The absolute path of the command that starts the helper.
 *
 * A set {@link CLI_PATH_ENV} always wins and must be an absolute path: there is no fallback. When
 * it is unset the bridge looks for `mcp-execution-cli` (`.exe` on Windows) itself, in the absolute
 * `PATH` entries only. Empty, `.` and other relative entries are skipped, and a bare name is
 * never handed to `spawn`, because on Windows the process search order puts the current
 * directory first and a planted binary would run (CWE-427). One rule serves every platform.
 *
 * Pure on its arguments, so the Windows rules are testable anywhere.
 *
 * @param platform - `process.platform` value to decide for
 * @param configured - Value of {@link CLI_PATH_ENV}, if set
 * @param pathValue - Value of `PATH`, if set
 * @param isFile - Whether a candidate path is an existing regular file
 * @throws {McpToolError} `call_failed`, naming {@link CLI_PATH_ENV} and never repeating its value
 */
export function resolveHelperCommand(
  platform: string,
  configured: string | undefined,
  pathValue: string | undefined,
  isFile: (path: string) => boolean
): string {
  const paths = platform === 'win32' ? win32 : posix;
  if (configured !== undefined) {
    if (!paths.isAbsolute(configured)) {
      throw new McpToolError('call_failed', unusableCliMessage('it is not an absolute path'));
    }
    return configured;
  }

  const fileName = platform === 'win32' ? `${DEFAULT_CLI_NAME}.exe` : DEFAULT_CLI_NAME;
  for (const entry of (pathValue ?? '').split(paths.delimiter)) {
    if (entry === '' || !paths.isAbsolute(entry)) continue;
    const candidate = paths.join(entry, fileName);
    if (isFile(candidate)) return candidate;
  }
  throw new McpToolError(
    'call_failed',
    `${DEFAULT_CLI_NAME} not found on PATH; set ${CLI_PATH_ENV}`
  );
}

/** Spawns `mcp-execution-cli helper` and talks to it over its stdio, without a shell. */
function spawnedWire(onFailure: (reason: string) => void): Wire {
  const configured = process.env[CLI_PATH_ENV];
  const command = resolveHelperCommand(
    process.platform,
    configured,
    process.env.PATH,
    isExistingFile
  );
  const env = { ...process.env };
  delete env[HELPER_ENV];
  delete env[HELPER_TOKEN_ENV];

  const child = spawn(command, ['helper'], {
    stdio: ['pipe', 'pipe', 'inherit'],
    env,
    windowsHide: true
  });
  child.on('error', (error: NodeJS.ErrnoException) => {
    const code = error.code ?? 'spawn error';
    onFailure(
      configured === undefined
        ? `cannot start ${DEFAULT_CLI_NAME} (${code}); ` +
            `set ${CLI_PATH_ENV} to the absolute path of mcp-execution-cli`
        : unusableCliMessage(`it cannot be started (${code})`)
    );
  });
  child.on('close', (code, signal) => {
    onFailure(`the helper exited (code ${code ?? 'null'}, signal ${signal ?? 'null'})`);
  });
  process.on('exit', () => {
    if (child.exitCode === null && child.signalCode === null) child.kill();
  });

  return {
    readable: child.stdout,
    writable: child.stdin,
    setRef: (active) => {
      refHandle(child, active);
      refHandle(child.stdout, active);
      refHandle(child.stdin, active);
    },
    destroy: () => {
      child.stdin.destroy();
      child.kill();
    }
  };
}

let connection: HelperConnection | undefined;

/**
 * The process's helper connection, created on first use: the channel the preload registered when
 * there is one, otherwise a spawned helper. A runner-announced channel that was not registered is
 * an error, never a reason to start a second helper.
 */
function getConnection(): HelperConnection {
  if (connection !== undefined) return connection;

  const registered = (globalThis as Record<symbol, unknown>)[CHANNEL_KEY];
  if (registered !== undefined) {
    connection = new HelperConnection(registeredWire(registered), false);
  } else if (process.env[HELPER_ENV] !== undefined) {
    throw new McpToolError(
      'call_failed',
      `${HELPER_ENV} is set but no helper channel was registered; start the script with ` +
        'mcp-execution-cli run'
    );
  } else if (process.env[RUN_MARKER_ENV]) {
    // A worker thread or child process has no channel of its own. Spawning a plain helper here
    // would let its calls skip the dry-run policy and the journal of the run.
    throw new McpToolError(
      'call_failed',
      'refused: tool calls from a child process or worker thread are not supported under `run`; ' +
        'call tools from the main script'
    );
  } else {
    let created: HelperConnection | undefined;
    const wire = spawnedWire((reason) => created?.fail(reason));
    created = new HelperConnection(wire, true);
    connection = created;
  }
  return connection;
}

/**
 * Call an MCP tool on a server through the helper.
 *
 * @param serverId - Server identifier (e.g., "github")
 * @param toolName - Tool name as defined by the MCP server (e.g., "create_issue")
 * @param params - Tool parameters as object
 * @param resultSource - Which part of the response carries the result: `'structured'` prefers
 *   `structuredContent` (tools with a declared output schema), `'content'` the content text
 * @returns Tool execution result, or `undefined` for an empty success
 * @throws {McpToolError} For every failure: `tool_error` (the tool reported `isError`),
 *   `rpc_error` (a JSON-RPC error), `write_skipped` (a dry run did not execute a write) or
 *   `call_failed` (transport, limit, timeout or a lost helper channel)
 *
 * @example
 * ```typescript
 * const result = await callMCPTool('github', 'create_issue', {
 *   owner: 'user',
 *   repo: 'project',
 *   title: 'Bug report'
 * });
 * console.log(result); // { number: 123, url: '...', state: 'open' }
 * ```
 */
export async function callMCPTool(
  serverId: string,
  toolName: string,
  params: Record<string, unknown>,
  resultSource: ResultSource = 'content'
): Promise<unknown> {
  try {
    const value = await getConnection().call(serverId, toolName, params, resultSource);
    if (value !== undefined) {
      recordObservedShape(serverId, toolName, value);
    }
    return value;
  } catch (error) {
    if (error instanceof McpToolError) throw error;
    throw new McpToolError('call_failed', error instanceof Error ? error.message : String(error));
  }
}
